# Copy this file to .env. The real .env is ignored by git and must stay private.

# The origin used in generated RSS/audio URLs. For a private Tailscale-only
# deployment this is the dashboard URL itself, e.g.
#   PODCASTSYNC_PUBLIC_URL=http://100.x.y.z:8642
# For the public Caddy profile it is your HTTPS domain, e.g.
#   PODCASTSYNC_PUBLIC_URL=https://podcast.example.com
PODCASTSYNC_PUBLIC_URL=http://127.0.0.1:8642

# Optional: bind the private dashboard to a specific interface instead of
# loopback. Use your server's private Tailscale address when the dashboard
# should be reachable from other devices on your Tailnet; never set this to
# 0.0.0.0.
# PODCASTSYNC_BIND_IP=127.0.0.1

# Optional: overrides the container image (defaults to ghcr.io/shay2000/podcastsync:latest).
# PODCASTSYNC_IMAGE=ghcr.io/shay2000/podcastsync:latest

# Optional: enables full channel history, handle resolution, and durations.
YOUTUBE_API_KEY=

# Optional: how often PodcastSync checks YouTube, in minutes.
PODCASTSYNC_POLL_INTERVAL=30

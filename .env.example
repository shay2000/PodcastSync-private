# Copy this file to .env. The real .env is ignored by git and must stay private.

# The domain used for public RSS and audio URLs. Create an A record for it first.
PODCASTSYNC_DOMAIN=podcast.example.com
PODCASTSYNC_PUBLIC_URL=https://podcast.example.com

# Optional: enables full channel history, handle resolution, and durations.
YOUTUBE_API_KEY=

# Optional: how often PodcastSync checks YouTube, in minutes.
PODCASTSYNC_POLL_INTERVAL=30
